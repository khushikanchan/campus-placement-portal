{
  "name": "campus-placement-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Accessible, interactive campus placement portal demo",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "db:validate": "prisma validate --config prisma7.config.ts",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:push": "prisma db push --config prisma7.config.ts",
    "db:migrate": "prisma migrate dev --config prisma7.config.ts",
    "db:seed": "tsx prisma/seed.ts",
    "jira:setup": "node scripts/jira/setup.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "prisma": "^7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.5"
  },
  "engines": { "node": ">=20" }
}
